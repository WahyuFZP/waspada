{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build"],
      "port": 8000
    },
    {
      "name": "apk-scanner",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apk-scanner/backend && PATH=$PWD/.venv/bin:$PATH exec .venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --reload"],
      "port": 8001
    },
    {
      "name": "web-scanner",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd web-scanner/backend && PATH=$PWD/.venv/bin:$PATH exec .venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002 --reload"],
      "port": 8002
    },
    {
      "name": "web-rentan",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd web-scanner/fixtures && exec python3 app.py"],
      "port": 8003
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
